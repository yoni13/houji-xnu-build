houji: the firmware dozed between beacons on an idle link (about 105 ms per idle ping); tell it power save is off once the link
is authorized.
--- a/src/nw_wifi.c
+++ b/src/nw_wifi.c
@@ -146,6 +146,15 @@
   for (int i = 0; i < 4 && o < n; i++) { if (!dp->reo_dst_ring[i].vaddr) continue; struct hal_srng *s = &ab->hal.srng_list[dp->reo_dst_ring[i].ring_id];
     spin_lock_bh(&s->lock); int w = ath12k_hal_srng_dst_num_free(ab, s, true); spin_unlock_bh(&s->lock); o += snprintf(b + o, n - o, " %d", w); }
   if (o < n) snprintf(b + o, n - o, "; queued %u, dropped %u", nw_rx_backlog(), nw_rx_dropped()); }
+/* houji: the Kiwi v2 firmware dozed between beacons once a link went idle (about 105 ms for an idle ping, 3 ms under load) although the
+ * vdev was created with power save off; after authorization it is told again, for each station vdev. */
+void nw_wifi_ps_off(void) {
+  if (!g_hw) return;
+  struct ath12k *ar = ath12k_ah_to_ar(g_hw->priv, 0); struct ath12k_link_vif *arvif;
+  list_for_each_entry(arvif, &ar->arvifs, list) {
+    if (arvif->ahvif->vdev_type != WMI_VDEV_TYPE_STA) continue;
+    int r = ath12k_wmi_pdev_set_ps_mode(ar, arvif->vdev_id, WMI_STA_PS_MODE_DISABLED);
+    lx_log(6, "wifi: power save off on vdev %u: %d", arvif->vdev_id, r); } }
